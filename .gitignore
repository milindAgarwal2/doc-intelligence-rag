# Secrets
.env

# Python
__pycache__/
*.pyc

# Virtual environment
.venv/

# Generated vector store
chroma_Name/

# Generated extracted tables
table/
*.pkl

# Saved chat sessions / exports
chatbot*.json
# Dated scratch/export JSON dumps (e.g. 10072026.json, 10082026AM.json)
[0-9]*.json

# Generated documents (FEATURES.md is tracked; the exported .docx is not)
*.docx

# Application log files (the logs/ dir is kept via .gitkeep; files are ignored)
logs/*.log
*.log

# WSL metadata
*:Zone.Identifier

# Kiro knowledge base / local tooling
.kiro/

# Debug screenshots
screen/

# Local SLM model weights (large; downloaded separately, not shipped)
models/
*.gguf

# Source documents are DATA, not code — and are frequently confidential
# (internal decks, customer data, PII). Ignore the source PDFs/PPTX decks AND
# their extracted asset subfolders by default so a real document is never
# committed by accident. If you want to ship a deliberate, non-sensitive sample,
# place it under pdf/samples/ or pptx/samples/ (carved out below) or force-add it
# explicitly with `git add -f`.
pdf/*
pptx/*
!pdf/samples/
!pptx/samples/
# Keep the folders themselves in the tree via .gitkeep (if present).
!pdf/.gitkeep
!pptx/.gitkeep
