# Secrets
.env

# Python
__pycache__/
*.pyc

# Virtual environment
.venv/

# Generated vector store
chroma_Name/

# Generated extracted tables
table/
*.pkl

# Saved chat sessions / exports
chatbot*.json

# WSL metadata
*:Zone.Identifier

# Kiro knowledge base / local tooling
.kiro/

# Debug screenshots
screen/

# Extracted image subfolders under pdf/ (keep source PDFs themselves)
pdf/**/
!pdf/
!pdf/*.pdf

# Source PPTX decks: keep the decks, ignore any extracted subfolders.
# (PPTX figures/tables are actually written under pdf/<doc>/ and table/<doc>/,
#  which are already ignored above; this keeps the pptx/ folder tidy too.)
pptx/**/
!pptx/
!pptx/*.pptx
!pptx/*.ppt
