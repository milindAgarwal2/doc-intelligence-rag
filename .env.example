ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Number of leading pages to skip in each PDF during ingestion
# (e.g. cover page + table of contents). Default 0 = process every page.
# Set to 4 to reproduce the original behavior of skipping the first 4 pages.
SKIP_PAGES=0

# --- Q&A history database (Postgres) -----------------------------------------
# The DB PASSWORD is a secret, so it lives here (not config.json). The logging
# ON/OFF toggle and retention days are non-secret and live in config.json
# (editable from the Admin Console → Q&A History tab).
#
# These defaults match the docker-compose 'db' service. For a non-Docker run,
# point DB_HOST at your Postgres host. If DB connection fails, answering still
# works — logging just no-ops (fail-safe).
POSTGRES_DB=techdoc
POSTGRES_USER=techdoc
POSTGRES_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432
